# ============================================================
# Generated data & report files
# ============================================================
# Example text reports & outputs
examples/*.txt
examples/transforms/*.txt
examples/bring_your_own_data_*.txt
examples/lightning_logs/
examples/datasets/
examples/runs/
scripts/sample_dataset/
*.executed

# Test data & outputs
tests/datasets/*
!tests/datasets/*.py
tests/utils/data/
examples/datasets/
scripts/sample_dataset/
tests/**/*.txt
tests/datasets/profile_datasets.out

# Generated plots
tests/utils/profile.png

# TorchSig internal weights
torchsig/utils/pfb_weights/

# ============================================================
# Docs build output
# ============================================================
docs/build/
docs/_build/
docs/_autosummary/
docs/_static/

# ============================================================
# Keep tracked config, docs & example data
# (these live outside the generated-data rules above and are
#  therefore tracked automatically; listed here for clarity)
# ============================================================
!torchsig/datasets/default_configs/*.yaml
!examples/scripts/*.yaml
!docs/docs-requirements.txt
!docs/*.png
!**/LICENSE*
